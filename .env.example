# ===== Обязательно =====
# Секрет для сессий: длинная случайная строка (сгенерировать: npx auth secret)
AUTH_SECRET=
# Любая случайная строка: от неё зависит порядок героев дня. НЕ МЕНЯЙ после запуска.
GAME_SALT=

# ===== Discord (и Activity, и вход на сайте) =====
# Developer Portal → твоё приложение → OAuth2 → Client ID / Client Secret
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Тот же Client ID, но доступный браузеру (нужен Activity)
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# ===== Google (вход на сайте, необязательно) =====
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== База Upstash Redis (Vercel подставит сам при подключении через Storage) =====
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Монетизация =====
# off (по умолчанию) — всё открыто всем, удобно для теста с друзьями. on — включить платные функции.
PAYWALL=off
# Ключ для админки (создание промокодов). Длинная случайная строка.
ADMIN_SECRET=
# Ссылка на страницу доната (Boosty, DonationAlerts и т.п.)
NEXT_PUBLIC_DONATE_URL=
# Адрес сайта для кнопки «Поделиться» (например https://dotadle.vercel.app)
NEXT_PUBLIC_SITE_URL=
# С какого дня доступен архив
LAUNCH_DAY=2026-11-21

# ===== Только для локальной разработки! Никогда не включай на Vercel =====
# DEV_LOGIN=1
# NEXT_PUBLIC_DEV_LOGIN=1
